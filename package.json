{
  "name": "kirox",
  "version": "0.1.0",
  "description": "CLI tool to fetch Kiro specification and steering files from remote GitHub repositories",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "kirox": "dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yukihirop/kirox.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "clean": "rm -rf dist",
    "prebuild": "npm run clean",
    "build": "tsc && tsc-alias",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": [
    "cli",
    "kiro",
    "spec-driven-development",
    "github",
    "fetch",
    "specification",
    "cc-sdd"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.8.6",
    "@types/figlet": "^1.7.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "figlet": "^1.9.3",
    "octokit": "^4.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@types/node": "^20.17.10",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "tsc-alias": "^1.8.10",
    "typescript-eslint": "^8.46.0",
    "vitest": "^2.1.8",
    "yaml": "^2.8.1"
  }
}
