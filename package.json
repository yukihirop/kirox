{
  "name": "kirox",
  "version": "0.1.2",
  "description": "CLI tool to fetch Kiro specification and steering files from remote GitHub repositories",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "kirox": "dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yukihirop/kirox.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "lint:knip": "knip",
    "lint:all": "npm run lint && npm run lint:knip",
    "knip": "knip",
    "format": "prettier --write \"src/**/*.ts\"",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "bumpp": "bumpp"
  },
  "keywords": [
    "cli",
    "kiro",
    "spec-driven-development",
    "github",
    "fetch",
    "specification",
    "cc-sdd"
  ],
  "author": "yukihirop",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@inquirer/prompts": "7.8.6",
    "chalk": "5.3.0",
    "cli-width": "4.1.0",
    "commander": "12.1.0",
    "figlet": "1.9.3",
    "mute-stream": "2.0.0",
    "octokit": "4.0.2",
    "ora": "^9.0.0",
    "pino": "^10.1.0",
    "yoctocolors-cjs": "2.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@tsconfig/node22": "^22.0.2",
    "@types/figlet": "^1.7.0",
    "@types/node": "^20.17.10",
    "@vitest/coverage-v8": "^2.1.8",
    "bumpp": "^10.3.1",
    "esbuild-plugin-tsconfig-paths": "^1.0.1",
    "eslint": "^9.17.0",
    "knip": "^5.66.3",
    "prettier": "^3.4.2",
    "tsup": "^8.5.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.46.0",
    "vitepress": "^1.6.4",
    "vitepress-plugin-llms": "^1.8.1",
    "vitest": "^2.1.8",
    "yaml": "^2.8.1"
  }
}
