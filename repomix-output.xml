export function parseProjects(input: string): string[] {
  const trimmedInput = input.trim();
  if (trimmedInput === '') {
    return [];
  }
  // Split by comma, trim each element, and filter out empty strings
  return trimmedInput
    .split(',')
    .map(project => project.trim())
    .filter(project => project !== '');
}
